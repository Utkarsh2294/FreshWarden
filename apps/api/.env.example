# Required: local MongoDB or Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/freshwarden?replicaSet=rs0&directConnection=true
# Required: generate at least 32 random characters
JWT_SECRET=
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Set 1 only behind one trusted reverse proxy (for example Render ingress).
TRUST_PROXY=0
NODE_ENV=development
# Only for explicitly running the seed command. Never used as an auth fallback.
SEED_PASSWORD=
# Optional integrations; absent keys mean manual review, never a fake success
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_WHISPER_MODEL=
LLM_MAX_RPM_GEMINI=12
LLM_MAX_RPM_GROQ=25
DEVICE_SHARED_SECRET=
