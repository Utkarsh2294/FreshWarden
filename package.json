{
  "name": "freshwarden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "demo": "node tools/demo.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w apps/web",
    "seed": "npm run seed -w apps/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "mongodb-memory-server": "^10.3.0",
    "prettier": "^3.6.2"
  },
  "lint-staged": { "*.{js,jsx}": ["eslint --fix", "prettier --write"], "*.{json,css,md,yml}": "prettier --write" }
}
